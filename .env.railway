APP_NAME="MSG91 Dashboard"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_URL=${DATABASE_URL}

BROADCAST_CONNECTION=reverb
CACHE_STORE=database
CACHE_PREFIX=msg91_
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=predis
REDIS_URL=${REDIS_URL}

REVERB_APP_ID=msg91_app
REVERB_APP_KEY=d89c74ab-854e-4a6f-ad57-141b3076f283
REVERB_APP_SECRET=a0743dee-f25f-4523-b149-8f5688216483
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# These must be set manually in the Railway Dashboard Variables:
# MSG91_AUTH_KEY=
# MSG91_INTEGRATED_NUMBER=
# MSG91_WEBHOOK_SECRET=
