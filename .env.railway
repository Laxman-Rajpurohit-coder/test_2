APP_NAME="MSG91 Dashboard"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://${RAILWAY_PUBLIC_DOMAIN}

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=${DATABASE_HOST}
DB_PORT=${DATABASE_PORT}
DB_DATABASE=${DATABASE_NAME}
DB_USERNAME=${DATABASE_USER}
DB_PASSWORD=${DATABASE_PASSWORD}

BROADCAST_CONNECTION=reverb
CACHE_STORE=redis
CACHE_PREFIX=msg91_
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=${REDIS_HOST}
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_PORT=${REDIS_PORT}

REVERB_APP_ID=msg91_app
REVERB_APP_KEY=antigravity_reverb_key
REVERB_APP_SECRET=antigravity_reverb_secret
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${RAILWAY_PUBLIC_DOMAIN}"
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# These must be set manually in the Railway Dashboard Variables:
# MSG91_AUTH_KEY=
# MSG91_INTEGRATED_NUMBER=
# MSG91_WEBHOOK_SECRET=
